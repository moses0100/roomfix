APP_NAME=RoomFix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
APP_MAINTENANCE_DRIVER=file
ROOMFIX_BUILDING="บ้านอุ่นใจ เรสซิเดนซ์"
ROOMFIX_DEMO=true
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=roomfix
DB_USERNAME=roomfix
DB_PASSWORD=roomfix_local_only
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@roomfix.test"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
